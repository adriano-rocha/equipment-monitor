# DATABASE_URL abaixo é para execução LOCAL (backend rodando fora do Docker).
# Quando o backend rodar via docker-compose (T02+), o host "postgres" (nome do
# serviço) é usado no lugar de "localhost" — essa variável é SOBRESCRITA
# diretamente no docker-compose.yml para o serviço `backend`, não lida daqui.
DATABASE_URL=postgresql+psycopg://equipment_monitor:changeme@localhost:5432/equipment_monitor


# PostgreSQL
POSTGRES_USER=equipment_monitor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=equipment_monitor

# JWT (usuários do dashboard)
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Heartbeat (ADR-003)
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=90

# Telegram (Fase 05)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nunca commitar o .env real — apenas este .env.example.
