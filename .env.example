# PostgreSQL
POSTGRES_USER=equipment_monitor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=equipment_monitor
DATABASE_URL=postgresql+psycopg://equipment_monitor:changeme@postgres:5432/equipment_monitor

# JWT (usuários do dashboard)
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Heartbeat (ADR-003)
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=90

# Telegram (Fase 05)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

